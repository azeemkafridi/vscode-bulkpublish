{
  "name": "bulkpublish",
  "displayName": "BulkPublish",
  "description": "Write, schedule and publish social media posts from your editor, and use BulkPublish from Copilot chat.",
  "version": "0.1.0",
  "publisher": "bulkpublish",
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://www.bulkpublish.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/azeemkafridi/vscode-bulkpublish"
  },
  "bugs": {
    "url": "https://github.com/azeemkafridi/vscode-bulkpublish/issues"
  },
  "galleryBanner": {
    "color": "#1A1A1A",
    "theme": "dark"
  },
  "categories": [
    "Other",
    "AI",
    "Chat"
  ],
  "keywords": [
    "social media",
    "scheduler",
    "publish",
    "twitter",
    "x",
    "linkedin",
    "bluesky",
    "mastodon",
    "instagram",
    "threads",
    "markdown",
    "copilot",
    "mcp",
    "bulkpublish"
  ],
  "engines": {
    "vscode": "^1.101.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "bulkpublish.setApiKey",
        "title": "Set API key",
        "category": "BulkPublish"
      },
      {
        "command": "bulkpublish.signOut",
        "title": "Sign out",
        "category": "BulkPublish"
      },
      {
        "command": "bulkpublish.compose",
        "title": "New post",
        "category": "BulkPublish",
        "icon": "$(add)"
      },
      {
        "command": "bulkpublish.refresh",
        "title": "Refresh",
        "category": "BulkPublish",
        "icon": "$(refresh)"
      },
      {
        "command": "bulkpublish.retryPost",
        "title": "Retry",
        "category": "BulkPublish",
        "icon": "$(debug-restart)"
      },
      {
        "command": "bulkpublish.shareSelection",
        "title": "Share selection",
        "category": "BulkPublish"
      },
      {
        "command": "bulkpublish.shareFile",
        "title": "Share this file",
        "category": "BulkPublish"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bulkpublish",
          "title": "BulkPublish",
          "icon": "media/sidebar.svg"
        }
      ]
    },
    "views": {
      "bulkpublish": [
        {
          "id": "bulkpublish.sidebar",
          "name": "Posts and channels"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "bulkpublish.sidebar",
        "when": "!bulkpublish.signedIn",
        "contents": "Connect your BulkPublish account to see your channels and posts.\n[Set API key](command:bulkpublish.setApiKey)\nCreate a key in BulkPublish under Settings → API Keys."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "bulkpublish.compose",
          "when": "view == bulkpublish.sidebar && bulkpublish.signedIn",
          "group": "navigation@1"
        },
        {
          "command": "bulkpublish.refresh",
          "when": "view == bulkpublish.sidebar && bulkpublish.signedIn",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "bulkpublish.retryPost",
          "when": "view == bulkpublish.sidebar && viewItem == post.retryable",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "command": "bulkpublish.shareSelection",
          "when": "editorHasSelection",
          "group": "bulkpublish@1"
        },
        {
          "command": "bulkpublish.shareFile",
          "when": "resourceLangId == markdown",
          "group": "bulkpublish@2"
        }
      ],
      "explorer/context": [
        {
          "command": "bulkpublish.shareFile",
          "when": "resourceLangId == markdown",
          "group": "bulkpublish@1"
        }
      ],
      "commandPalette": [
        {
          "command": "bulkpublish.retryPost",
          "when": "false"
        },
        {
          "command": "bulkpublish.shareSelection",
          "when": "editorHasSelection"
        }
      ]
    },
    "configuration": {
      "title": "BulkPublish",
      "properties": {
        "bulkpublish.apiUrl": {
          "type": "string",
          "default": "https://app.bulkpublish.com",
          "description": "Address of your BulkPublish account. Leave as is unless BulkPublish support asks you to change it."
        },
        "bulkpublish.assistantServerUrl": {
          "type": "string",
          "default": "https://mcp.bulkpublish.com/mcp",
          "description": "Address Copilot chat uses to reach BulkPublish's tools. Leave as is unless BulkPublish support asks you to change it."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "bulkpublish.assistant",
        "label": "BulkPublish"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:prod": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:host": "node esbuild.mjs && node test/integration/run.mjs",
    "vscode:prepublish": "npm run typecheck && npm run build:prod",
    "package": "vsce package --no-dependencies",
    "publish:vsce": "vsce publish --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies",
    "harness": "node test/browser/serve.mjs",
    "showcase": "node esbuild.mjs && node test/integration/showcase.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.101.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "mocha": "^12.0.3",
    "ovsx": "^1.3.0",
    "typescript": "5.9",
    "vitest": "^5.0.5"
  }
}
